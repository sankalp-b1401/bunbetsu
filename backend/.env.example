# Bunbetsu Backend Environment Variables
# Configure these in your Vercel Project Settings (Project -> Settings -> Environment Variables)

# Frontend production URL for CORS (e.g. your Vercel frontend project domain)
FRONTEND_URL=https://your-frontend-project.vercel.app

# Optional comma-separated additional allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional CORS origin regex (defaults to allowing all *.vercel.app preview deployments)
# CORS_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# Optional custom OpenStreetMap Overpass API endpoint for pedestrian routing
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Recommended Vercel build environment variable to support packages like scipy/numpy/shapely/pyproj
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1

