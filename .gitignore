# ==========================================
# Bunbetsu - Git Ignore Rules
# ==========================================

# ------------------------------------------
# Project Specific
# ------------------------------------------
research/
*.zip

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert

# ------------------------------------------
# Python (Backend & ML)
# ------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Linters & Type Checking
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Packaging & Distribution
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Jupyter Notebooks
.ipynb_checkpoints/

# ------------------------------------------
# Frontend (Node / React / Vite / TS)
# ------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js
# Source directory whitelist
!frontend/src/lib/
# Build outputs
frontend/dist/
dist/
dist-ssr/

# Framework and tooling caches
.cache/
.vite/
.vercel/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.log
logs/

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Editor temp and swap files
*.swp
*.swo
*~

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

