# Bunbetsu Frontend Environment Variables

# Base URL of the Bunbetsu FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Supabase Authentication & User Profile Configuration
# SAFE: Use project URL and Publishable (anon) Key only.
# DANGER: NEVER expose secret, service_role, or master keys in frontend code or environment files.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Required Supabase Dashboard URL Configuration:
# In Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL: http://localhost:3000
# - Redirect URLs:
#   - http://localhost:3000/
#   - http://127.0.0.1:3000/
#   - https://your-production-domain.com/
